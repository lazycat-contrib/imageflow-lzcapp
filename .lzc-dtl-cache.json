{
  "name": "ImageFlow",
  "package": "cloud.lazycat.app.imageflow",
  "description": "高效智能的图像管理和分发系统",
  "homepage": "https://github.com/Yuri-NagaSaki/ImageFlow",
  "author": "Yuri-NagaSaki",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "image-flow",
  "version": "1.3.0",
  "public_paths": [
    "/"
  ],
  "iconPath": "favicon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "images_8686_8686": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_soyorins_imageflow": {
    "originalImage": "soyorins/imageflow",
    "pushTarget": "none"
  },
  "images_volume_/app/static/images_action": "emptyDir",
  "images_volume_/app/static/images_location": "app_data",
  "images_volume_/app/config_action": "emptyDir",
  "images_volume_/app/config_location": "app_data",
  "images_volume_/app/.env_action": "emptyDir",
  "images_volume_/app/.env_location": "app_data"
}
